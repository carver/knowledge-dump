#!/bin/sh
# Lint, type-check and test what's staged. Enabled by install_sandbox.py (core.hooksPath).
set -e
cd "$(git rev-parse --show-toplevel)"
tree=$(mktemp -d)
trap 'rm -rf "$tree"' EXIT
# Check the staged snapshot, not the working tree, without touching either.
git checkout-index -a --prefix="$tree/"
cd "$tree"
python3 -m ruff check --quiet .
python3 -m ruff format --check --quiet .
python3 -m mypy --no-error-summary
python3 -m pytest -q -p no:cacheprovider
