#!/bin/sh
# What CI runs, slow tests included, for agents' commits (llm-toolbox agent-commit-gate).
# Tests the working tree. Humans can run it by hand.
set -e
cd "$(git rev-parse --show-toplevel)"
TAB_SQUASHER_DIR=${TAB_SQUASHER_DIR:-$(cd ../tab-squasher && pwd)}
export TAB_SQUASHER_DIR
python3 -m ruff check --quiet .
python3 -m ruff format --check --quiet .
python3 -m mypy --no-error-summary
python3 -m pytest -q -p no:cacheprovider
